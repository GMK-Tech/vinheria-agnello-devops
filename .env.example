# Copie para ".env" e troque os valores. O .env NUNCA vai para o Git.

# off = HTTP puro (para mostrar o problema no Wireshark) | on = HTTPS/TLS
TLS=off

# Segredos dos tokens JWT (use textos longos e aleatórios, diferentes entre si)
USER_JWT_SECRET=troque-este-segredo-de-usuario-por-um-texto-longo
SERVICE_JWT_SECRET=troque-este-segredo-de-servico-por-outro-texto-longo

# Senha dos usuários de demonstração "comercial" e "auditor"
SENHA_DEMO=troque-esta-senha
